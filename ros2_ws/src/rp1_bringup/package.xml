<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rp1_bringup</name>
  <version>0.0.1</version>
  <description>Top-level launch files and robot-specific parameter overrides for the rp1 MVP.</description>
  <maintainer email="uzi.mor@gmail.com">uzi.mor</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joy</exec_depend>
  <exec_depend>rp1_teleop</exec_depend>
  <exec_depend>rp1_control</exec_depend>
  <exec_depend>rp1_dronecan_bridge</exec_depend>
  <exec_depend>rp1_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
