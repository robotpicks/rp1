<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rp1_elrs</name>
  <version>0.0.1</version>
  <description>rp1 glue for the generic elrs_driver (elrs_ros submodule): a DynamicJointState -&gt; sensor_msgs/BatteryState adapter so rp1 telemetry reaches the ELRS handset, plus rp1's ELRS configs and launch.</description>
  <maintainer email="uzi.mor@gmail.com">uzi.mor</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>
  <exec_depend>elrs_driver</exec_depend>
  <exec_depend>rp1_teleop</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
