<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rp1_elrs</name>
  <version>0.0.1</version>
  <description>ExpressLRS (CRSF over UART) RC input + handset telemetry for rp1: CRSF RC channels -&gt; sensor_msgs/Joy (reusing rp1_teleop), WheelFeedback -&gt; CRSF battery telemetry.</description>
  <maintainer email="uzi.mor@gmail.com">uzi.mor</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>rp1_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
