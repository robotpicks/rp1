<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rp1_dronecan_bridge</name>
  <version>0.0.1</version>
  <description>ROS2 &lt;-&gt; DroneCAN bridge for rp1: WheelCommand -&gt; esc.RawCommand, esc.Status -&gt; WheelFeedback.</description>
  <maintainer email="uzi.mor@gmail.com">uzi.mor</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rp1_msgs</depend>

  <!-- Transport libs, imported lazily so the package still builds and dry-runs
       (require_can:=false) without them. python3-can is a stock rosdep key; dronecan has no
       upstream key or distro package, so it comes from the repo-local rule in
       rosdep/robotpicks.yaml, which resolves it via pip. -->
  <exec_depend>python3-can</exec_depend>
  <exec_depend>dronecan</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
