<?xml version="1.0"?>
<!--
  rp1 MVP description: the 4 drive wheels, skid-steer, no steering joints.

  GEOMETRY IS FROM THE CAD, NOT YET CONFIRMED BY MECHANICAL DESIGN. track width ~1.139 m,
  wheelbase ~0.8 m, wheel radius ~0.215 m come from tools/export_urdf_meshes.py in the
  rp1-mechanical submodule, measured directly off the ZLLG16ASM800 hub-motor placements in
  UZM.08.13.300.00.FCStd -- docs/mechanical_request.{pdf,xlsx}'s §3.1/§3.3.2 tables are still
  blank (nobody from mechanical design has filled them in), so this is the first real number,
  not a placeholder round number, but it is CAD-nominal, not a measured/loaded rolling radius,
  and which end of the (front-back- and left-right-symmetric) chassis is "front"/"left" was an
  arbitrary pick in that script (FRONT_IS_POSITIVE_CAD_Z / LEFT_IS_POSITIVE_CAD_X) -- confirm
  both against the physical robot before relying on this for anything safety-relevant. Update
  here AND in rp1_bringup/config/rp1_controllers.yaml (diff_drive_controller takes
  wheel_separation and wheel_radius as its own parameters, it does not read them from this file).

  base_link is at the ground projection of the geometric centre of the four wheel contact
  patches, X forward / Y left / Z up (REP-103). The CAD is modelled +Y-up (confirmed by
  measuring the actual hub-motor positions, not assumed) -- export_urdf_meshes.py's CAD_TO_ROS
  rotation accounts for that; §1 of the mechanical request still asks mechanical design to
  confirm the frame convention independently.

  Steering actuators are deliberately NOT in this description: the same VescDroneCanSystem component
  handles them (see rp1_steering.urdf), but including them here would broadcast an
  actuator.ArrayCommand every cycle with whatever the unclaimed command interface holds, at
  wheels that have no encoder yet. Add them when the swerve controller exists.

  Meshes and the joint <origin> numbers below come from the rp1-mechanical FreeCAD assembly via
  tools/export_urdf_meshes.py in that submodule -- re-run it and update both after a CAD change.
-->
<robot name="rp1">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/chassis.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://rp1_description/meshes/chassis.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Drive wheels. esc_index is the value set on that VESC's "UAVCAN ESC index" field in VESC
       Tool; it must match docs/can_id_map.md's wheel index table. -->
  <link name="wheel_front_left_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_front_left.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_front_left.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="drive_front_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="0.399903 0.569306 0.215396" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_front_right_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_front_right.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_front_right.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="drive_front_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.400097 -0.569306 0.215396" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_left_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_rear_left.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_rear_left.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="drive_rear_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.400097 0.569306 0.215396" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_right_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_rear_right.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_rear_right.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="drive_rear_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.399903 -0.569306 0.215396" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="rp1_drive" type="system">
    <hardware>
      <plugin>vesc_dronecan_driver/VescDroneCanSystem</plugin>
      <param name="can_iface">can0</param>
      <param name="node_id">42</param>
      <!-- Motor revolutions per wheel revolution. PLACEHOLDER: §3.4.5 of the mechanical
           request. 1.0 means direct drive. -->
      <param name="gear_ratio">1.0</param>
      <!-- si_motor_poles / 2 from the VESC motor configuration. PLACEHOLDER: read it off the
           motor detection results in VESC Tool. -->
      <param name="motor_pole_pairs">7.0</param>
      <!-- VESC firmware is asymmetric about RPM units on the wire: esc.Status.rpm is divided by
           pole pairs before sending (mechanical RPM), but handle_esc_rpm_command() feeds
           RPMCommand straight into mc_interface_set_pid_speed() as ERPM. true compensates for
           that. Set false only after the firmware fork scales the command side too. -->
      <param name="command_rpm_is_erpm">true</param>
    </hardware>

    <joint name="drive_front_left">
      <param name="esc_index">0</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_front_right">
      <param name="esc_index">1</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_left">
      <param name="esc_index">2</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_right">
      <param name="esc_index">3</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <!-- Per-ESC telemetry from the same esc.Status messages. Reaches /dynamic_joint_states via
         joint_state_broadcaster; rp1_elrs turns it into the handset's BatteryState. -->
    <gpio name="esc_front_left">
      <param name="esc_index">0</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_front_right">
      <param name="esc_index">1</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_left">
      <param name="esc_index">2</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_right">
      <param name="esc_index">3</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
  </ros2_control>
</robot>
