<?xml version="1.0"?>
<robot name="rp1_steering">
  <!-- Minimal skeleton -- just enough links/joints for ros2_control to load two of the steering
       actuators (see docs/can_id_map.md's +4 steering-index convention:
       front-right drive=2 -> steering=6, rear-left drive=3 -> steering=7). Not a real physical
       description of the robot; rp1 has no full URDF yet.

       Joint origins are from the CAD (tools/export_urdf_meshes.py in the rp1-mechanical
       submodule), not yet confirmed by mechanical design: the pivot is the mean position of
       each corner's steering bearings + spur gears, which sit tightly on the real shaft
       centreline -- NOT the corner's own CAD reference point, which is ~37mm off of it. The
       height (~1.22m above base_link) looks large but matches the rest of the geometry: this
       is a portal-style corner leg, with the steering motor/gearbox mounted up near the
       chassis and a long shaft down to the wheel (see rp1_drive.urdf's wheel joints, ~0.22m
       above base_link). The motor drives the shaft through a 4:1 spur gear reduction (20T
       pinion -> 80T gear, confirmed identical at all 4 corners) -- noted for reference only,
       since vesc_dronecan_system.cpp doesn't apply any gear_ratio to actuator position
       commands (that hardware param is drive-only). Front/rear and left/right are the same
       arbitrary CAD-symmetry pick as rp1_drive.urdf's -- see that file's header. -->
  <link name="base_link"/>

  <link name="steering_front_right_link"/>
  <joint name="steering_front_right" type="continuous">
    <parent link="base_link"/>
    <child link="steering_front_right_link"/>
    <origin xyz="0.400000 -0.640000 1.221896" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="steering_rear_left_link"/>
  <joint name="steering_rear_left" type="continuous">
    <parent link="base_link"/>
    <child link="steering_rear_left_link"/>
    <origin xyz="-0.400000 0.640000 1.221896" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <ros2_control name="rp1_steering" type="system">
    <hardware>
      <plugin>vesc_dronecan_driver/VescDroneCanSystem</plugin>
      <param name="can_iface">can0</param>
      <!-- Distinct from rp1_drive.urdf's 42: this bench description runs on its own, so the two
           never share a bus at the same time. When the swerve controller merges drive and
           steering into one description they collapse to a single node ID. -->
      <param name="node_id">44</param>
    </hardware>
    <joint name="steering_front_right">
      <param name="actuator_id">6</param>
      <command_interface name="position"/>
      <!-- Edge-triggered "seek home" command: write HOME_TARGET_0DEG (0.0) or HOME_TARGET_90DEG
           (1.0, see uavcan/equipment/actuator/Command.h in the vesc_dronecan_ros submodule's
           vendored DSDL) to send a single COMMAND_TYPE_HOME actuator.Command -- the seek move
           itself runs entirely in firmware (canard_driver.c's homing_tick(), on the bldc repo's
           swerve branch), not here. Read home_0deg/home_90deg below (via the paired <gpio>
           block) to know when it's done. -->
      <command_interface name="seek_home"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steering_rear_left">
      <param name="actuator_id">7</param>
      <command_interface name="position"/>
      <command_interface name="seek_home"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 0/90-degree proximity ("home") switch status, per steering actuator -- see the
         "seek_home" command interfaces above. Reaches /dynamic_joint_states via
         joint_state_broadcaster; needs publish_dynamic_joint_states: true and
         use_urdf_to_filter: false, same as rp1_drive.urdf's ESC telemetry gpio blocks. -->
    <gpio name="steering_sensors_front_right">
      <param name="actuator_id">6</param>
      <state_interface name="home_0deg"/>
      <state_interface name="home_90deg"/>
    </gpio>
    <gpio name="steering_sensors_rear_left">
      <param name="actuator_id">7</param>
      <state_interface name="home_0deg"/>
      <state_interface name="home_90deg"/>
    </gpio>
  </ros2_control>
</robot>
