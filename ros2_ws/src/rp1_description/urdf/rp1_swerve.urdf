<?xml version="1.0"?>
<!--
  rp1 full swerve description: 4 drive wheels + 4 steering actuators on one ros2_control block/
  node ID, for use with the swerve controller (rp1_swerve_controller) and its mock/Gazebo/RViz
  bringups. Distinct from rp1_drive.urdf (MVP, drive-only, no steering joints -- still the
  4-wheel-only mainline description) and rp1_steering.urdf (2-actuator bench description) --
  those two stay as they are for their own purposes; this is the merged description
  rp1/CLAUDE.md's "Extending to full swerve" section anticipated once a swerve controller exists.

  Link hierarchy per corner is base_link -> steering_X_link -> wheel_X_link (a steering joint,
  then the drive joint hanging off it), NOT base_link -> wheel_X_link directly like
  rp1_drive.urdf -- physically correct for a steered wheel, and necessary for the visual model to
  actually show the wheel turning when the steering joint is commanded.

  Steering-axis origins are rp1-specs/mechanical_spec.md's §3.1 CAD table. Each drive joint's
  origin, relative to its steering link, is (drive_joint_position - steering_axis_position) in
  base_link coordinates -- since the steering joint's own origin has zero rotation at rest, this
  same vector is valid as the drive joint's origin in the steering link's frame. The lateral
  component of that offset (~0.0707 m) is the CAD's confirmed scrub radius (mechanical_spec.md
  §3.2); the ~1.0065 m Z drop is the portal-style corner leg (steering motor/gearbox mounted up
  near the chassis, long shaft down to the wheel) already described in rp1_steering.urdf.

  Meshes, chassis/wheel collision and inertial blocks are unchanged from rp1_drive.urdf -- see
  that file's header for their caveats (CAD-derived, not mechanical-design-confirmed; guessed
  mass/inertia). Re-run tools/export_urdf_meshes.py in rp1-mechanical and update all three URDFs
  after a CAD change.
-->
<robot name="rp1">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/chassis.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.007 0 0.740" rpy="0 0 0"/>
      <geometry>
        <box size="1.016 1.512 1.110"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.007 0 0.740" rpy="0 0 0"/>
      <mass value="300.0"/>
      <inertia ixx="87.95" ixy="0" ixz="0" iyy="56.61" iyz="0" izz="82.96"/>
    </inertial>
  </link>

  <!-- Front-left -->
  <link name="steering_front_left_link">
    <!-- Small placeholder inertia -- this link is otherwise massless (a coordinate frame for
    the steering axis, not a real CAD part), which Gazebo's physics engine (DART) rejects on any
    link connected only by movable joints. Negligible next to the 300kg chassis/15kg wheels;
    revisit with a real steering-hub mass if/when that's CAD-confirmed. Only matters for the
    Gazebo tier -- mock/real DroneCAN hardware ignore inertial blocks entirely. -->
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="steering_front_left" type="continuous">
    <parent link="base_link"/>
    <child link="steering_front_left_link"/>
    <origin xyz="0.400000 0.640000 1.221896" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Placeholder, not yet tuned against real hardware -- CAD-unconfirmed torque/speed limits
    for the steering actuator's 4:1-reduced output. Continuous joints don't strictly require
    <limit> per the URDF spec, but omitting it left Gazebo's physics falling back to values too
    restrictive for the commanded position to actually track in reasonable time (see
    rp1_swerve_gazebo.launch.py's docstring). damping/friction are similarly untuned guesses,
    just enough to avoid free-spin instability without adding their own sluggishness. -->
    <limit effort="10.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <link name="wheel_front_left_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_front_left.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.2154" length="0.1549"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.204034" ixy="0" ixz="0" iyy="0.3481" iyz="0" izz="0.204034"/>
    </inertial>
  </link>
  <joint name="drive_front_left" type="continuous">
    <parent link="steering_front_left_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="-0.000097 -0.070694 -1.006500" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- Placeholder, not yet tuned against real hardware -- same reasoning as the steering
    joints' <limit>/<dynamics> above, for the drive wheel's velocity-controlled joint. -->
    <limit effort="20.0" velocity="50.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Front-right -->
  <link name="steering_front_right_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="steering_front_right" type="continuous">
    <parent link="base_link"/>
    <child link="steering_front_right_link"/>
    <origin xyz="0.400000 -0.640000 1.221896" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Placeholder, not yet tuned against real hardware -- CAD-unconfirmed torque/speed limits
    for the steering actuator's 4:1-reduced output. Continuous joints don't strictly require
    <limit> per the URDF spec, but omitting it left Gazebo's physics falling back to values too
    restrictive for the commanded position to actually track in reasonable time (see
    rp1_swerve_gazebo.launch.py's docstring). damping/friction are similarly untuned guesses,
    just enough to avoid free-spin instability without adding their own sluggishness. -->
    <limit effort="10.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <link name="wheel_front_right_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_front_right.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.2154" length="0.1549"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.204034" ixy="0" ixz="0" iyy="0.3481" iyz="0" izz="0.204034"/>
    </inertial>
  </link>
  <joint name="drive_front_right" type="continuous">
    <parent link="steering_front_right_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.000097 0.070694 -1.006500" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- Placeholder, not yet tuned against real hardware -- same reasoning as the steering
    joints' <limit>/<dynamics> above, for the drive wheel's velocity-controlled joint. -->
    <limit effort="20.0" velocity="50.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Rear-left -->
  <link name="steering_rear_left_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="steering_rear_left" type="continuous">
    <parent link="base_link"/>
    <child link="steering_rear_left_link"/>
    <origin xyz="-0.400000 0.640000 1.221896" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Placeholder, not yet tuned against real hardware -- CAD-unconfirmed torque/speed limits
    for the steering actuator's 4:1-reduced output. Continuous joints don't strictly require
    <limit> per the URDF spec, but omitting it left Gazebo's physics falling back to values too
    restrictive for the commanded position to actually track in reasonable time (see
    rp1_swerve_gazebo.launch.py's docstring). damping/friction are similarly untuned guesses,
    just enough to avoid free-spin instability without adding their own sluggishness. -->
    <limit effort="10.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <link name="wheel_rear_left_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_rear_left.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.2154" length="0.1549"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.204034" ixy="0" ixz="0" iyy="0.3481" iyz="0" izz="0.204034"/>
    </inertial>
  </link>
  <joint name="drive_rear_left" type="continuous">
    <parent link="steering_rear_left_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.000097 -0.070694 -1.006500" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- Placeholder, not yet tuned against real hardware -- same reasoning as the steering
    joints' <limit>/<dynamics> above, for the drive wheel's velocity-controlled joint. -->
    <limit effort="20.0" velocity="50.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Rear-right -->
  <link name="steering_rear_right_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="steering_rear_right" type="continuous">
    <parent link="base_link"/>
    <child link="steering_rear_right_link"/>
    <origin xyz="-0.400000 -0.640000 1.221896" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Placeholder, not yet tuned against real hardware -- CAD-unconfirmed torque/speed limits
    for the steering actuator's 4:1-reduced output. Continuous joints don't strictly require
    <limit> per the URDF spec, but omitting it left Gazebo's physics falling back to values too
    restrictive for the commanded position to actually track in reasonable time (see
    rp1_swerve_gazebo.launch.py's docstring). damping/friction are similarly untuned guesses,
    just enough to avoid free-spin instability without adding their own sluggishness. -->
    <limit effort="10.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <link name="wheel_rear_right_link">
    <visual>
      <geometry>
        <mesh filename="package://rp1_description/meshes/wheel_rear_right.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.2154" length="0.1549"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.204034" ixy="0" ixz="0" iyy="0.3481" iyz="0" izz="0.204034"/>
    </inertial>
  </link>
  <joint name="drive_rear_right" type="continuous">
    <parent link="steering_rear_right_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="0.000097 0.070694 -1.006500" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- Placeholder, not yet tuned against real hardware -- same reasoning as the steering
    joints' <limit>/<dynamics> above, for the drive wheel's velocity-controlled joint. -->
    <limit effort="20.0" velocity="50.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <ros2_control name="rp1_swerve" type="system">
    <hardware>
      <plugin>vesc_dronecan_driver/VescDroneCanSystem</plugin>
      <param name="can_iface">can0</param>
      <param name="node_id">42</param>
      <param name="gear_ratio">1.0</param>
      <param name="motor_pole_pairs">7.0</param>
      <param name="command_rpm_is_erpm">true</param>
    </hardware>

    <joint name="drive_front_left">
      <param name="esc_index">0</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_front_right">
      <param name="esc_index">1</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_left">
      <param name="esc_index">2</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_right">
      <param name="esc_index">3</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <!-- actuator_id = drive esc_index + 4, per docs/can_id_map.md's steering convention. -->
    <joint name="steering_front_left">
      <param name="actuator_id">4</param>
      <!-- Only read by gz_ros2_control's GazeboSimSystem (the one tunable gain it exposes, per
      its own ROS parameter declaration) -- ignored by VescDroneCanSystem/mock_components on the
      other two tiers, same as every other <param> here that's really only meaningful to one
      hardware plugin. Placeholder, not yet tuned against real hardware: without it (or too low
      a value), Gazebo's simulated position servo tracked the commanded steering angle sluggishly
      -- see rp1_swerve_gazebo.launch.py's docstring. -->
      <param name="position_proportional_gain">50.0</param>
      <command_interface name="position"/>
      <command_interface name="seek_home"/>
      <command_interface name="brake"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steering_front_right">
      <param name="actuator_id">5</param>
      <!-- Only read by gz_ros2_control's GazeboSimSystem (the one tunable gain it exposes, per
      its own ROS parameter declaration) -- ignored by VescDroneCanSystem/mock_components on the
      other two tiers, same as every other <param> here that's really only meaningful to one
      hardware plugin. Placeholder, not yet tuned against real hardware: without it (or too low
      a value), Gazebo's simulated position servo tracked the commanded steering angle sluggishly
      -- see rp1_swerve_gazebo.launch.py's docstring. -->
      <param name="position_proportional_gain">50.0</param>
      <command_interface name="position"/>
      <command_interface name="seek_home"/>
      <command_interface name="brake"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steering_rear_left">
      <param name="actuator_id">6</param>
      <!-- Only read by gz_ros2_control's GazeboSimSystem (the one tunable gain it exposes, per
      its own ROS parameter declaration) -- ignored by VescDroneCanSystem/mock_components on the
      other two tiers, same as every other <param> here that's really only meaningful to one
      hardware plugin. Placeholder, not yet tuned against real hardware: without it (or too low
      a value), Gazebo's simulated position servo tracked the commanded steering angle sluggishly
      -- see rp1_swerve_gazebo.launch.py's docstring. -->
      <param name="position_proportional_gain">50.0</param>
      <command_interface name="position"/>
      <command_interface name="seek_home"/>
      <command_interface name="brake"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steering_rear_right">
      <param name="actuator_id">7</param>
      <!-- Only read by gz_ros2_control's GazeboSimSystem (the one tunable gain it exposes, per
      its own ROS parameter declaration) -- ignored by VescDroneCanSystem/mock_components on the
      other two tiers, same as every other <param> here that's really only meaningful to one
      hardware plugin. Placeholder, not yet tuned against real hardware: without it (or too low
      a value), Gazebo's simulated position servo tracked the commanded steering angle sluggishly
      -- see rp1_swerve_gazebo.launch.py's docstring. -->
      <param name="position_proportional_gain">50.0</param>
      <command_interface name="position"/>
      <command_interface name="seek_home"/>
      <command_interface name="brake"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Per-ESC telemetry, same as rp1_drive.urdf. -->
    <gpio name="esc_front_left">
      <param name="esc_index">0</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_front_right">
      <param name="esc_index">1</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_left">
      <param name="esc_index">2</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_right">
      <param name="esc_index">3</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>

    <!-- 0/90-degree home-switch status per steering actuator, same as rp1_steering.urdf. -->
    <gpio name="steering_sensors_front_left">
      <param name="actuator_id">4</param>
      <state_interface name="home_0deg"/>
      <state_interface name="home_90deg"/>
    </gpio>
    <gpio name="steering_sensors_front_right">
      <param name="actuator_id">5</param>
      <state_interface name="home_0deg"/>
      <state_interface name="home_90deg"/>
    </gpio>
    <gpio name="steering_sensors_rear_left">
      <param name="actuator_id">6</param>
      <state_interface name="home_0deg"/>
      <state_interface name="home_90deg"/>
    </gpio>
    <gpio name="steering_sensors_rear_right">
      <param name="actuator_id">7</param>
      <state_interface name="home_0deg"/>
      <state_interface name="home_90deg"/>
    </gpio>
  </ros2_control>

  <!-- Only read when spawned into gz sim (rp1_swerve_gazebo.launch.py) via gz_ros2_control --
  mock/real DroneCAN hardware (ros2_control_node, a plain process) never look for a <gazebo> tag.
  The <ros2_control><hardware><plugin> above gets text-substituted to gz_ros2_control/
  GazeboSimSystem for that tier (same technique rp1_swerve_mock.launch.py already uses for
  mock_components/GenericSystem); GazeboSimSystem only understands standard joint interfaces
  (position/velocity/effort) backed by a real Gazebo joint entity, so it does not export
  seek_home, brake, or any <gpio> state interface (no physical entity to back those with) -- see
  rp1_swerve_controller's README for how the controller tolerates that. The placeholder text
  below the <parameters> tag gets substituted with rp1_swerve_controllers.yaml's real installed
  path at launch time, the same way can_iface does for rp1_swerve_dronecan.launch.py. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>PARAMS_FILE_PLACEHOLDER</parameters>
    </plugin>
  </gazebo>
</robot>
